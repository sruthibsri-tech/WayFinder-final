# Gemini API key — get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model (gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Bright Data MCP token — used for live web search/scrape
BRIGHTDATA_API_TOKEN=your_brightdata_api_token_here

# Optional: enables Bright Data browser/agent tools
# BRIGHTDATA_PRO_MODE=true

